{{ 'feature-product-with-popup.css' | asset_url | stylesheet_tag }}

    <div class="product-grid">
        <div class="container">
            <h3 class="product-grid__heading">Tisso vison in the wild</h3>
            <div class="product-grid__item-main">
                {% for block in section.blocks %} 
                    {% assign product = block.settings.product %}
                        <div class="product-grid__item">
                            <div class="product-grid__item__image">
                                <img src="{{ product.featured_image | image_url: width: 800 }}" width="100%" height="100%" alt="{{ product.title }}">
                            </div>

                            <button class="more-details" data-product-handle="{{ product.handle }}">
                                <img src="{{ 'plus-icon.png' | asset_url }}" alt="PopUp Icon" width="100%" height="100%">
                            </button>
                        </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {% comment %}
        Product modal popup
    {% endcomment %}
    <div class="modal" id="modal">
        <div class="modal-content">
            <button type="button" class="close-button" aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M12.025 11.176L8.85 8l3.175-3.176a.6.6 0 1 0-.849-.849L8 7.151 4.825 3.975a.6.6 0 1 0-.849.849L7.151 8l-3.175 3.176a.6.6 0 1 0 .849.849L8 8.849l3.176 3.176a.6.6 0 1 0 .849-.849z" fill="#121212"/>
                </svg>
            </button>
            <div class="modal-body">
                <div class="modal-body__info">
                    <div class="modal-body__info__image largePopupImage">
                      <img src="{{ 'banner-content-img.png' | asset_url }}" alt="" width="100%" height="100%">
                    </div>
                    <div class="modal-body__info__content">
                        <h2 class="modal-body__info__content__title" id="popup-product-title"></h2>
                        <p class="modal-body__info__content__price" id="popup-product-price"></p>
                        <p class="modal-body__info__desc" id="popup-product-description"></p>
                    </div>
                </div>

                <div class="modal-body__varients-info">
                    <div id="popup-colors"></div>
                    <div id="popup-sizes"></div>
                </div>

                <button id="add-to-cart-btn" class="btn btn-cart">Add to Cart
                    <span class="icon"><img src="{{ 'arrow-white.png' | asset_url }}" alt="Button Icon" width="100%" height="100%"></span>
                </button>
            </div>
        </div>
    </div>

{% schema %}
    {
        "name": "Products With Popup",
        "class": "product-with-popup",
        "settings": [
        ],
        "blocks": [
            {
                "type": "product",
                "name": "Product",
                "settings": [
                    {
                        "type": "product",
                        "id": "product",
                        "label": "Add Product"
                    }
                ]
            }
        ],
        "presets": [
            {
                "name":"Products With Popup"
            }
        ]
    }

{% endschema %}

<script src="{{ 'product-popup.js' | asset_url }}" defer="defer"></script>
